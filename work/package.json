{
  "dependencies": {
    "@mantine/core": "^9.7.0",
    "@mantine/hooks": "^9.7.0",
    "esbuild": "^0.25.10",
    "fastify": "^5.12.5",
    "lucide": "^0.468.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.180.0"
  },
  "scripts": {
    "check": "node tools/check.cjs",
    "check:affected": "node tools/affected-check.cjs",
    "check:tools": "node --test tools/test/*.test.cjs",
    "check:report": "node tools/check-report.cjs",
    "typecheck:frontend": "tsc --noEmit -p tsconfig.frontend.json",
    "preview": "node tools/preview.cjs",
    "experiment:cost": "node tools/cost-experiments.cjs",
    "frontend:fast": "node tools/frontend-fast.cjs",
    "browser:check": "node tools/browser-check.cjs",
    "browser:scenario": "node tools/browser-smoke.cjs",
    "backend:build": "tsc -p backend/tsconfig.json",
    "backend:test": "npm run backend:build && node --test backend/test/*.test.mjs",
    "start": "npm run backend:build && node server.cjs",
    "build": "npm run backend:build && node build.cjs",
    "test": "npm run backend:build && node test-runner.cjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "linkedom": "^0.18.13",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2"
  }
}
