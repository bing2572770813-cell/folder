{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "allowJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["react", "react-dom"]
  },
  "include": ["react-entry.tsx", "types/**/*.d.ts"]
}
